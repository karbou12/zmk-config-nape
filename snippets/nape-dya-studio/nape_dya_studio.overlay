&trackball {
    status = "okay";
    compatible = "pixart,pmw3610";
    spi-max-frequency = <2000000>;
    motion-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

    res-cpi = <800>;

    zephyr,axis-x = <INPUT_REL_X>;
    zephyr,axis-y = <INPUT_REL_Y>;

    smart-mode;
    force-awake;
};

/ {
    trackball0: trackball0 {
        compatible = "cormoran,physical-layout-trackball";
        display-name = "Trackball";
        size = <100>;
        x = <100>;
        y = <100>;

        linked-device-identifiers = "trackball_sensor", "trackball_button";
        linked-subsystems = "zmk__trackball", "zmk__pointing_buttons";
    };
};
