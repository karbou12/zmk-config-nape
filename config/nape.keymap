#include <dt-bindings/zmk/mouse.h>

// マウス移動とスクロールのデフォルト値を設定

#define ZMK_POINTING_DEFAULT_MOVE_VAL 800
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/pmw3610_rotation.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <mouse-gesture.dtsi>

#define L_USB_SOUTH 0
#define L_USB_WEST  2
#define L_USB_NORTH 4
#define L_USB_KIMON 5
#define L_USB_EAST  6
#define L_BT_SEL    8
#define L_BT_CLR    9
#define L_SCROLL   10
#define L_TB       11
#define L_SNIPE    12
#define L_TAB      13
#define LEFT_SPACE   LC(LEFT)
#define RIGHT_SPACE  LC(RIGHT)
#define MISSION_CTRL LC(UP)
#define EXPOSE       LC(DOWN)
#define LEFT_TAB     LS(LC(TAB))
#define RIGHT_TAB    LC(TAB)

// マウス移動の設定

&mmv {
    delay-ms = <0>;              // 遅延なし
    trigger-period-ms = <10>;    // 10ミリ秒ごとにトリガー
    time-to-max-speed-ms = <0>;  // 即座に最大速度に
    acceleration-exponent = <1>;  // 線形加速
};

// マウススクロールの設定

&msc {
    delay-ms = <0>;              // 遅延なし
    trigger-period-ms = <10>;    // 10ミリ秒ごとにトリガー
    time-to-max-speed-ms = <0>;  // 即座に最大速度に
    acceleration-exponent = <0>;  // 加速なし
};

&zip_mouse_gesture {
    stroke-size = <200>; // default: 200
    enable-eager-mode;

    right_space {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp RIGHT_SPACE>;
    };

    left_space {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LEFT_SPACE>;
    };

    mission_ctrl {
        pattern = <GESTURE_UP>;
        bindings = <&kp MISSION_CTRL>;
    };

    expose {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp EXPOSE>;
    };
};

&trackball_listener {
    compatible = "zmk,input-listener";
    input-processors = <&zip_mouse_gesture>;
};

// 入力プロセッサーの設定

/ {
    input_processors {
        // 垂直スクロールのスケーラー

        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };

        // 水平スクロールのスケーラー

        zip_hwheel_scaler: zip_hwheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };
    };
};

// カスタムビヘイビアの定義

/ {
    behaviors {
        // マウスカーソル移動の回転検出

        mouse_mv: mouse_cursor_move {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&mmv>, <&mmv>;

            tap-ms = <10>;
        };

        // マウスホイールスクロールの回転検出

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <10>;
        };

        lt_mkp: lt_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "T:mkp, H:Layer";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        it_mkp: interrupted_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "T:mkp, H in term:Layer";
            bindings = <&mo>, <&mkp>;
            flavor = "tap-unless-interrupted";

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mod_mkp: mod_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "Mod Tap with mkp";
            bindings = <&kp>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "MB3, Scroll TraboShift";
            bindings = <&lt_mkp L_SCROLL MB3>, <&mo L_TB>;
            #binding-cells = <0>;
            tapping-term-ms = <300>;
        };
    };

    macro {
        app_list: app_list {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp GLOBE>, <&macro_tap &kp LS(A)>, <&macro_release &kp GLOBE>;
        };
    };

    // キーマップの定義

    keymap {
        compatible = "zmk,keymap";

        // レイヤー0（0°、USBポートを下向きにした状態）"

        orientation0_layer {
            bindings = <
// Front                                                                  Back
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &td0                             &lt_mkp L_TAB MB2 &it_mkp L_TAB MB1      &mo L_BT_SEL &mo L_BT_CLR &mo L_TB
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー1（時計回り45°）

        orientation45_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &trans                            &trans           &trans                 &trans       &trans       &trans
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー2（時計回り90°）

        orientation90_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &trans                            &trans           &trans                 &trans       &trans       &trans
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー3（時計回り135°）

        orientation135_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &trans                            &trans           &trans                 &trans       &trans       &trans
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー4（時計回り180°）

        orientation180_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &trans                            &trans           &trans                 &trans       &trans       &trans
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー5（時計回り225°）

        orientation225_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &trans                            &trans           &trans                 &trans       &trans       &trans
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー6（時計回り270°）

        orientation270_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &trans                            &trans           &trans                 &trans       &trans       &trans
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー7（時計回り315°）

        orientation315_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &trans                            &trans           &trans                 &trans       &trans       &trans
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー8（Bluetooth選択レイヤー）

        btsel_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &bt BT_SEL 0                      &bt BT_SEL 1     &bt BT_SEL 2           &none        &bt BT_SEL 3 &bt BT_SEL 4
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー9（Bluetoothクリアレイヤー）

        btclr_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &none                             &none            &none                  &bt BT_CLR   &none        &bt BT_CLR_ALL
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー10（スクロールレイヤー）

        scroll_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &lt_mkp L_TB MB3                  &lt_mkp L_TB MB5 &lt_mkp L_TB MB4       &none        &none        &none
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;

            // トラックボールの動きをスクロールに変換

            //sensor-bindings =
            //    <&mouse_scrl SCRL_DOWN SCRL_UP>,
            //    <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        // レイヤー11（TraboShiftレイヤー）

        trabo_shift_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &to L_USB_KIMON                   &tb_rot_45 ROT_CW   &tb_rot_45 ROT_CCW  &to L_USB_SOUTH &to L_USB_NORTH &none
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー12（Snipeレイヤー）

        snipe_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &mkp MB3                          &mkp MB2         &mkp MB1               &none        &none        &none
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };

        // レイヤー13（Tabレイヤー）
        tab_layer {
            bindings = <
//╭────────────────┬────────────────┬────────────────┬────────────────╮     ╭────────────┬────────────┬────────────╮
//|                | trackball      |                |                |     |  1         |  2         |  3         |
  &app_list                         &kp RIGHT_TAB    &kp LEFT_TAB           &none        &none        &none
//╰────────────────┴────────────────┴────────────────┴────────────────╯     ╰────────────┴────────────┴────────────╯
            >;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // combo_scroll_layer {
        //     bindings = <&mo L_SCROLL>;
        //     key-positions = <1 2>;
        //     timeout-ms = <50>;
        // };

        combo_mouse_gester {
            bindings = <&mouse_gesture>;
            key-positions = <1 2>;
            timeout-ms = <50>;
        };

        combo_snipe_layer {
            bindings = <&mo L_SNIPE>;
            key-positions = <0 1>;
            timeout-ms = <50>;
        };
    };
};
